{
  "name": "folia-android",
  "productName": "Folia",
  "description": "Folia 音乐播放器安卓版 —— 动态歌词、AI 主题生成、多音源聚合（原生桥架构）",
  "author": {
    "name": "Timingyyds",
    "email": "Timingyyds@users.noreply.github.com"
  },
  "private": true,
  "version": "1.7.0",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:probe": "vite --open /dev-probe.html",
    "build": "vite build",
    "build:capacitor": "cross-env FOLIA_BUILD_TARGET=capacitor VITE_NETEASE_API_BASE=extension VITE_KUGOU_API_BASE=extension VITE_QQ_API_BASE=extension vite build",
    "cap:sync:android": "npm run build:capacitor && cap sync android",
    "cap:open:android": "cap open android",
    "cap:run:android": "npm run build:capacitor && cap run android",
    "build:android:debug": "npm run cap:sync:android && cd android && gradlew.bat assembleDebug",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "codemap": "node dev/mcp/ts-code-map/codemap.mjs",
    "codemap:check": "node dev/mcp/ts-code-map/codemap.mjs --check",
    "test": "vitest run -c vitest.config.ts",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:unit:watch": "vitest -c vitest.config.ts",
    "test:ui": "playwright test",
    "test:component": "playwright test --project=components",
    "test:ui:update": "playwright test --update-snapshots",
    "test:render": "playwright test -c playwright.probe.config.ts",
    "benchmark:lyrics": "npx tsx test/manual/lyrics_benchmark.ts",
    "manual:lyrics": "npx tsx test/manual/netease_lyrics_cli.ts",
    "audit:lyrics-sources": "npx tsx test/manual/lyric-audit/index.ts",
    "probe:netease-xeapi": "node test/manual/netease_xeapi_probe.cjs",
    "manual:visualizer-memory": "node test/manual/visualizer-memory-probe.mjs",
    "manual:lattice-cover-memory": "node test/manual/lattice-cover-memory.mjs",
    "manual:bravais-perf": "node test/manual/bravais-perf-probe.mjs",
    "stage:client": "vite --open /stage-client.html",
    "contributors:add": "npx all-contributors-cli add",
    "contributors:generate": "npx all-contributors-cli generate"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@neteasecloudmusicapienhanced/api": "^4.41.1",
    "@xhayper/discord-rpc": "^1.5.1",
    "@yakult-green-tea/qq-music-api": "3.1.4",
    "axios": "^1.20.0",
    "bodian-music-api": "0.1.2",
    "budoux": "^0.6.3",
    "fflate": "^0.8.3",
    "file-type": "^21.3.4",
    "music-metadata": "^11.16.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@applemusic-like-lyrics/ttml": "^1.0.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@chenglou/pretext": "^0.0.9",
    "@paper-design/shaders-react": "^0.0.80",
    "@playwright/test": "^1.63.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "animejs": "^4.5.0",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.26",
    "blueimp-md5": "^2.19.0",
    "buffer": "^6.0.3",
    "cross-env": "^10.1.0",
    "dexie": "^4.4.6",
    "fake-indexeddb": "^6.2.5",
    "framer-motion": "^13.4.3",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsdom": "^24.1.3",
    "lucide-react": "^1.48.0",
    "opencc-js": "^1.4.2",
    "pinyin-pro": "3.29.3",
    "pixi.js": "^8.21.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-window": "^2.3.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "twgl.js": "^7.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wanakana": "^5.3.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "7.29.7",
    "concurrently": {
      "shell-quote": "1.12.0"
    },
    "@discordjs/rest": {
      "undici": "^6.27.0"
    },
    "qs": "6.16.0",
    "three-stdlib": {
      "fflate": "$fflate"
    }
  }
}